# =============================================================================
# S2 Talk — environment configuration
#
# Copy this file to .env and fill in the values you need:
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
#
# .env is loaded automatically on startup (via python-dotenv) — you never
# need to edit any Python/JS files to configure the app.
# =============================================================================

# --- Flask -------------------------------------------------------------
# Any long random string. Used to sign session cookies.
FLASK_SECRET_KEY=change-this-to-a-random-secret-string

# Port the dev server listens on. Defaults to 5000 if unset.
PORT=5000

# Email of the account to auto-promote to admin every time the server
# starts. Register a normal account with this email first, then restart
# the server — it becomes an admin automatically. Leave blank to skip.
# See ADMIN_SETUP.md for full details.
ADMIN_EMAIL=

# --- AI provider ---------------------------------------------------------
# Which AI provider powers the S2 Agent chat feature.
# Options: gemini | anthropic | openai | groq
AI_PROVIDER=gemini

# --- Gemini (Google AI Studio) -------------------------------------------
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave unset to use the built-in default (currently gemini-3.5-flash-lite,
# the model with the most generous free-tier daily quota that's still
# available to new API keys/projects). The app automatically falls back
# to other current Gemini models if this one is ever unavailable or
# quota-exceeded — no code changes needed.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic (Claude) ----------------------------------------------------
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI ----------------------------------------------------------------
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Groq --------------------------------------------------------------
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
